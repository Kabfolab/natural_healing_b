generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int      // in kobo, 5000 = 50 Naira x100
  image       String
  stock       Int      @default(10)
  category    String   @default("herbal")
  description String?
  createdAt   DateTime @default(now())
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerPhone String
  address       String
  total         Int
  status        String   @default("pending")
  paystackRef   String?  @unique
  items         Json
  createdAt     DateTime @default(now())
}
